{
  "schema": "gapit.typing/2",
  "schemes": [
    {
      "name": "pathotype",
      "rules": [
        {
          "model": "weighted_genes",
          "phenotype": "EHEC",
          "weights": {"marker_a": 1.0, "marker_c": 1.0},
          "identity_floor": 90.0,
          "require_any": ["marker_c"]
        },
        {
          "model": "weighted_genes",
          "phenotype": "EPEC",
          "weights": {"marker_a": 1.0},
          "negative": {"marker_c": -1.0},
          "identity_floor": 90.0
        }
      ],
      "cutoff": 0.9,
      "ambiguity_margin": 0.05,
      "fallback": "unassigned"
    },
    {
      "name": "toxin",
      "rules": [
        {
          "model": "weighted_genes",
          "phenotype": "Toxin1",
          "weights": {"marker_b": 1.0},
          "identity_floor": 95.0
        },
        {
          "model": "weighted_genes",
          "phenotype": "Toxin2",
          "weights": {"marker_d": 1.0},
          "identity_floor": 90.0
        }
      ],
      "cutoff": 0.9,
      "ambiguity_margin": 0.05,
      "fallback": "none"
    }
  ]
}
